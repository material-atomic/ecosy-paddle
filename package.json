{
  "name": "@ecosy/paddle",
  "version": "0.1.0",
  "description": "Paddle Billing for an app with plans: a plan's prices kept in Paddle, and webhooks read back as who has which plan until when.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "agents"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "eslint src/ && rollup -c",
    "test": "yarn build && yarn types:test && yarn test:run",
    "test:run": "node --test \"tests/*.test.mjs\"",
    "types:test": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --target ES2022 --module esnext --moduleResolution bundler --lib esnext --types node types-test/*.ts",
    "prepublishOnly": "yarn clean && yarn build && yarn test:run",
    "dev": "rollup -c --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/material-atomic/ecosy-paddle.git"
  },
  "keywords": [
    "ecosy",
    "paddle",
    "billing",
    "subscriptions",
    "payments",
    "webhooks",
    "saas",
    "typescript"
  ],
  "author": "material-atomic",
  "peerDependencies": {
    "@paddle/paddle-node-sdk": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.5",
    "tslib": "^2.8.1",
    "typescript": "6"
  },
  "engines": {
    "node": ">=22"
  },
  "agents": {
    "skills": [
      "$this://agents/skills/ecosy-paddle/SKILL.md"
    ]
  }
}
